# Brandthread environment template
# Copy to .env only for local development. Use Replit Secrets for deployed values.
# Leave every secret as a placeholder; never commit real values.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
SESSION_SECRET=replace-with-a-long-random-session-secret

# Development path prefix for artifacts that are not mounted at the root.
BASE_PATH=/

# ─── Clerk authentication ─────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: only set when using a dedicated Clerk proxy outside the default setup.
EXPO_PUBLIC_CLERK_PROXY_URL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional return URL override for Stripe Identity verification.
STRIPE_IDENTITY_RETURN_URL=
# Optional decimal platform fee, for example 0.05 for 5%.
PLATFORM_COMMISSION_RATE=

# ─── Replit-managed OpenAI integration ────────────────────────────────────────
# Use the Replit-managed values rather than a direct OpenAI API key.
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me
AI_INTEGRATIONS_OPENAI_BASE_URL=https://replace-me

# ─── Object storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-gcs-bucket-id
# Private upload prefix/path used by authenticated media flows.
PRIVATE_OBJECT_DIR=/your-gcs-bucket/.private
# Comma-separated public object search roots.
PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket/public

# ─── Email and notifications ──────────────────────────────────────────────────
# Optional: required for order/return/team-invite email (brandthreadEmail.ts)
# AND for transactional auth email — password reset codes, verify-email codes,
# welcome email (mailer.ts). Without RESEND_API_KEY, password reset requests
# return a typed MAIL_NOT_CONFIGURED error instead of silently doing nothing.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Brandthread <onboarding@example.com>
# From-address used by mailer.ts (auth email) specifically; falls back to
# RESEND_FROM_EMAIL, then a built-in default, if unset. Must be on a domain
# verified in Resend (see resend.com/domains).
MAIL_FROM=Brandthread <hello@brandthread.app>
# Expo push tokens are registered by clients; no server-side Expo token is read.

# ─── Live shopping / Agora ────────────────────────────────────────────────────
# Optional: required only when live audio/video rooms are enabled.
AGORA_APP_ID=replace_me
AGORA_APP_CERTIFICATE=replace_me

# ─── Client API routing ───────────────────────────────────────────────────────
# For local Expo work, point to the API server. In Replit these are populated by
# the workflow; do not hardcode a production hostname in source code.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_REPL_ID=

# Replit supplies these at runtime. They are shown for local workflow parity.
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
REPLIT_INTERNAL_APP_DOMAIN=
REPL_ID=

# ─── Optional integrations ────────────────────────────────────────────────────
# Klaviyo is currently connected per seller through the product; do not share
# a tenant's private key globally. This placeholder is only for a future,
# explicitly server-managed default integration.
KLAVIYO_PRIVATE_API_KEY=

# ─── Shopify fulfillment bridge ────────────────────────────────────────────────
# From the Brandthread app in the Shopify Partner Dashboard. See
# docs/integrations/shopify-tapstitch.md for exact setup steps.
SHOPIFY_APP_API_KEY=
SHOPIFY_APP_API_SECRET=
# Must exactly match an "Allowed redirection URL" configured on the app, e.g.
# https://<your-api-domain>/api/shopify/oauth/callback
SHOPIFY_APP_REDIRECT_URI=
# 32-byte key, base64-encoded (e.g. `openssl rand -base64 32`) used to encrypt
# Shopify access tokens at rest.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Never enable in a deployed environment without a real Tapstitch API key —
# see lib/fulfillmentPartners/tapstitchAdapter.ts. Tapstitch has no public API
# today; this only matters if that changes.
FULFILLMENT_PARTNER_ADAPTERS_ENABLED=false

# Meta (Facebook + Instagram) Ads — see docs/integrations/meta-ads.md
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.brandthread.app/meta-ads/oauth/callback
META_GRAPH_API_VERSION=v21.0
# 32-byte key, base64-encoded, for AES-256-GCM encryption of stored Meta tokens
META_TOKEN_ENCRYPTION_KEY=
# Random secret used to sign the OAuth `state` param (CSRF protection)
META_OAUTH_STATE_SECRET=
EXPO_PUBLIC_META_PIXEL_ID=

# ─── Development-only feature flags ───────────────────────────────────────────
# Never enable either bypass in a deployed environment.
ENABLE_TEST_SUBSCRIPTION_BYPASS=false
EXPO_PUBLIC_ENABLE_TEST_SUBSCRIPTION_BYPASS=false