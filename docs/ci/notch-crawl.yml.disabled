name: Notch safe-area crawl

# Runs the app-wide notch/Dynamic-Island + home-indicator + header-
# consistency crawl (artifacts/mobile/e2e/notch-crawl.spec.ts) on every PR
# touching app/ or components/, so a screen (or an in-screen Modal/sheet/tab
# reached only by tapping through another screen) with a header, close
# button, or sticky footer hidden behind the notch — or a title that doesn't
# match every other screen's size/position — never lands again. See that
# spec file's header comment for exactly what it checks and how.
#
# Fast mode (the default here) checks every route at depth 0 (does it load
# clean, on the default demo account) and only spends the slower multi-level
# button-tapping pass, and the brand-new "fresh account" data state, on
# routes whose screen file the PR actually touched — full depth-3 coverage
# of every route, both roles, both data states runs on a schedule instead
# (see the nightly job below), so PR turnaround stays fast without losing
# the exhaustive sweep entirely.

on:
  pull_request:
    branches: [dev]
    paths:
      - 'artifacts/mobile/app/**'
      - 'artifacts/mobile/components/**'
  schedule:
    # Full depth-3 crawl (every route, both roles, both data states), nightly.
    - cron: '17 9 * * *'
  workflow_dispatch: {}

jobs:
  notch-crawl:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Determine changed screen routes (PR runs only)
        if: github.event_name == 'pull_request'
        id: changed
        run: |
          git fetch origin "${{ github.base_ref }}" --depth=1
          changed_files=$(git diff --name-only "origin/${{ github.base_ref }}"...HEAD -- 'artifacts/mobile/app/**/*.tsx' 'artifacts/mobile/components/**/*.tsx')
          routes=$(node artifacts/mobile/scripts/notch-crawl-changed-routes.mjs <<< "$changed_files")
          echo "routes=$routes" >> "$GITHUB_OUTPUT"
          echo "Changed-file depth-1 route allowlist: $routes"

      - name: Run notch crawl (fast mode — depth 0 everywhere, deeper + fresh-account pass on changed routes)
        if: github.event_name == 'pull_request'
        working-directory: artifacts/mobile
        env:
          NOTCH_CRAWL_FAST: '1'
          NOTCH_CRAWL_ROUTES: ${{ steps.changed.outputs.routes }}
        run: pnpm exec playwright test e2e/notch-crawl.spec.ts --config e2e/playwright.config.ts --reporter=list

      - name: Run notch crawl (full — every route, depth 0-3, both roles, both data states)
        if: github.event_name != 'pull_request'
        working-directory: artifacts/mobile
        run: pnpm exec playwright test e2e/notch-crawl.spec.ts --config e2e/playwright.config.ts --reporter=list

      - name: Upload failure report and screenshots
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: notch-crawl-report
          path: artifacts/mobile/.notch-crawl/
          retention-days: 14
