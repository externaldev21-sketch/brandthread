name: Brandthread CI/CD

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: brandthread-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Install Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Verify mobile app identity
        run: pnpm --filter @workspace/mobile run verify:app-identity

      - name: Build shared database declarations
        run: pnpm --filter @workspace/db exec tsc --build

      - name: Type-check API and mobile
        run: |
          pnpm --filter @workspace/api-server run typecheck
          pnpm --filter @workspace/mobile run typecheck

      - name: Run API and mobile tests
        run: |
          pnpm --filter @workspace/api-server run test
          pnpm --filter @workspace/mobile run test

      - name: Build deployable services
        run: |
          pnpm --filter @workspace/api-server run build
          pnpm --filter @workspace/manufacturer-portal run build

  half-done-audit:
    # Whole-app Playwright audit (see artifacts/mobile/scripts/audit/half-done-audit.mjs):
    # loads every route under artifacts/mobile/app in both seller and buyer
    # preview modes, taps every visible control one level deep, and flags
    # dead controls, placeholder copy, console errors, broken images and the
    # "clarity standard" (font/contrast/hit-target/color-rule) checks.
    #
    # Gate policy (artifacts/mobile/scripts/audit/audit-gate.mjs):
    #   - Hard-tier findings (console errors, dead controls, placeholder
    #     copy, broken images, repeated/garbage labels, error-boundary
    #     screens) are zero-tolerance: ANY hard-tier finding fails the
    #     build, full stop — not just a *new* one. (half-done-audit.mjs's
    #     own `--ci` baseline-exemption mode still exists and is used
    #     nowhere in this pipeline; audit-gate.mjs replaces it here.)
    #   - Warn-tier findings (color/type-scale/contrast/hit-target/clipped/
    #     overlap/button-consistency — pervasive pre-existing debt across
    #     ~275 routes) are gated by a ratchet: the run's warn-tier count
    #     must be strictly below docs/audit/warn-baseline.json's recorded
    #     count, every single PR. It can only go down.
    # See docs/audit/README.md for full policy and how to update the
    # warn-tier baseline after a genuine improvement lands.
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Install Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Install Playwright Chromium
        run: pnpm --filter @workspace/mobile exec playwright install --with-deps chromium

      - name: Run half-done audit gate (zero-tolerance hard + warn ratchet)
        run: pnpm --filter @workspace/mobile run audit:gate

      - name: Upload audit report and screenshots
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: half-done-audit-report
          path: |
            docs/audit/half-done-findings.json
            docs/audit/half-done-audit-report.md
            artifacts/mobile/docs/audit/screenshots
          retention-days: 30

  deploy:
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
    needs: verify
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: production
    steps:
      - name: Trigger Replit production deployment
        env:
          REPLIT_DEPLOY_HOOK_URL: ${{ secrets.REPLIT_DEPLOY_HOOK_URL }}
        run: |
          if [ -z "$REPLIT_DEPLOY_HOOK_URL" ]; then
            echo "REPLIT_DEPLOY_HOOK_URL is not configured in the GitHub production environment." >&2
            exit 1
          fi
          curl --fail-with-body --silent --show-error \
            --retry 3 --retry-all-errors \
            -X POST "$REPLIT_DEPLOY_HOOK_URL"