{
  "expo": {
    "name": "Brandthread",
    "slug": "brandthread",
    "scheme": "brandthread",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brandthread.app"
    },
    "android": {
      "package": "com.brandthread.app"
    }
  }
}
