{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "extends": "preview",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "staging"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "ios": {
        "image": "latest",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "channel": "testflight",
      "ios": {
        "image": "latest",
        "autoIncrement": "buildNumber"
      }
    },
    "preview-ios-simulator": {
      "extends": "preview",
      "ios": {
        "image": "latest",
        "simulator": true
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "channel": "production-apk",
      "android": {
        "buildType": "apk",
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
