{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "CI=1 pnpm exec expo install --check && node scripts/prepare-managed-expo-session.js && EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PUBLIC_API_BASE_URL=https://$REPLIT_DEV_DOMAIN EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --lan --port $PORT",
    "build": "node scripts/build-web.js",
    "prebuild": "pnpm run verify:app-identity && pnpm run verify:apple-auth && pnpm run verify:ios-build",
    "eas-build-pre-install": "pnpm run verify:app-identity && pnpm run verify:apple-auth && pnpm run verify:ios-build && node scripts/sentry-upload-status.js",
    "native:prebuild": "node scripts/native-prebuild.js",
    "build:preview": "eas build --profile preview --platform all",
    "build:testflight": "node scripts/build-testflight.js",
    "update:preview": "node scripts/eas-update.js --channel preview",
    "update:production": "node scripts/eas-update.js --channel production",
    "update:rollback": "eas update:rollback",
    "screenshots": "node scripts/store-screenshots/capture.mjs",
    "serve": "node server/serve.js",
    "test": "vitest run",
    "test:navigation:web": "node tests/navigation-scene-isolation.web.mjs",
    "test:navigation:native": "vitest run tests/navigation-scene-isolation.native.test.tsx tests/navigation-scene-isolation.test.ts && node tests/navigation-scene-isolation.device.mjs",
    "test:navigation:native:ci": "NATIVE_GESTURE_REQUIRED=1 pnpm run test:navigation:native",
    "test:onboarding:native": "node tests/onboarding-transitions.device.mjs",
    "test:onboarding:native:ci": "NATIVE_ONBOARDING_REQUIRED=1 pnpm run test:onboarding:native",
    "test:seller-dashboard:native": "node tests/seller-dashboard.device.mjs",
    "test:seller-dashboard:native:ci": "NATIVE_SELLER_DASHBOARD_REQUIRED=1 pnpm run test:seller-dashboard:native",
    "test:seller-dashboard:android": "NATIVE_SELLER_DASHBOARD_PLATFORM=android node tests/seller-dashboard.device.mjs",
    "test:seller-dashboard:android:ci": "NATIVE_SELLER_DASHBOARD_PLATFORM=android NATIVE_SELLER_DASHBOARD_ANDROID_REQUIRED=1 node tests/seller-dashboard.device.mjs",
    "test:expo-go-startup": "node tests/expo-go-startup.device.mjs",
    "test:expo-go-startup:ios:ci": "EXPO_GO_STARTUP_PLATFORM=ios EXPO_GO_STARTUP_REQUIRED=1 node tests/expo-go-startup.device.mjs",
    "test:expo-go-startup:android:ci": "EXPO_GO_STARTUP_PLATFORM=android EXPO_GO_STARTUP_REQUIRED=1 node tests/expo-go-startup.device.mjs",
    "verify:release:expo-go": "pnpm run test:expo-go-startup:ios:ci && pnpm run test:expo-go-startup:android:ci",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:app-identity": "node scripts/verify-app-identity.js",
    "verify:apple-auth": "node scripts/verify-apple-auth.js",
    "verify:ios-build": "node scripts/verify-ios-build.js",
    "verify:privacy-manifest": "node scripts/verify-ios-privacy-manifest.js",
    "verify:privacy-manifest:config": "node scripts/verify-ios-privacy-manifest.js --config-only",
    "verify:submit-config": "node scripts/verify-submit-config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@clerk/expo": "^4.6.6",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "^0.86.3",
    "@sentry/cli": "2.58.4",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-test-renderer": "19.1.0",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.3.6",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "playwright": "1.56.1",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@react-navigation/native": "7.3.7",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "^57.0.5",
    "expo-clipboard": "^57.0.2",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "^57.0.19",
    "expo-local-authentication": "^57.0.3",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-runtime-app-icon": "0.1.2",
    "expo-sharing": "~57.0.21",
    "expo-updates": "~57.0.23",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-agora": "^4.6.2",
    "react-native-purchases": "^9.15.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-webview": "^13.16.1"
  }
}
