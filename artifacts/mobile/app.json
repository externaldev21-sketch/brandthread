    "android": {
      "package": "com.brandthread.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icons/monochrome-android-foreground.png",
        "backgroundColor": "#0A0A0B"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "./plugins/with-verify-app-identity",
      [
        "expo-runtime-app-icon",
        {
          "icons": {
            "monochrome": {
              "image": "./assets/images/app-icons/monochrome.png",
              "backgroundColor": "#0A0A0B",
              "androidForegroundImage": "./assets/images/app-icons/monochrome-android-foreground.png"
            },
            "purple": {
              "image": "./assets/images/app-icons/purple.png",
              "backgroundColor": "#281235",
              "androidForegroundImage": "./assets/images/app-icons/purple-android-foreground.png"
            },
            "olive": {
              "image": "./assets/images/app-icons/olive.png",
              "backgroundColor": "#2C311E",
              "androidForegroundImage": "./assets/images/app-icons/olive-android-foreground.png"
            },
            "navy": {
              "image": "./assets/images/app-icons/navy.png",
              "backgroundColor": "#09142F",
              "androidForegroundImage": "./assets/images/app-icons/navy-android-foreground.png"
            },
            "champagne": {
              "image": "./assets/images/app-icons/champagne.png",
              "backgroundColor": "#2A211A",
              "androidForegroundImage": "./assets/images/app-icons/champagne-android-foreground.png"
            },
            "black": {
              "image": "./assets/images/app-icons/black.png",
              "backgroundColor": "#171717",
              "androidForegroundImage": "./assets/images/app-icons/black-android-foreground.png"
            },
            "silver": {
              "image": "./assets/images/app-icons/silver.png",
              "backgroundColor": "#25272A",
              "androidForegroundImage": "./assets/images/app-icons/silver-android-foreground.png"
            },
            "black_gold": {
              "image": "./assets/images/app-icons/black-gold.png",
              "backgroundColor": "#0C0C0C",
              "androidForegroundImage": "./assets/images/app-icons/black-gold-android-foreground.png"
            },
            "emerald_gold": {
              "image": "./assets/images/app-icons/emerald-gold.png",
              "backgroundColor": "#182411",
              "androidForegroundImage": "./assets/images/app-icons/emerald-gold-android-foreground.png"
            },
            "leopard_red": {
              "image": "./assets/images/app-icons/leopard-red.png",
              "backgroundColor": "#231305",
              "androidForegroundImage": "./assets/images/app-icons/leopard-red-android-foreground.png"
            },
            "maroon": {
              "image": "./assets/images/app-icons/maroon.png",
              "backgroundColor": "#2B060B",
              "androidForegroundImage": "./assets/images/app-icons/maroon-android-foreground.png"
            },
            "gold": {
              "image": "./assets/images/app-icons/gold.png",
              "backgroundColor": "#241A0D",
              "androidForegroundImage": "./assets/images/app-icons/gold-android-foreground.png"
            }
          }
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Brandthread uses Face ID to confirm it's you when you turn on or use biometric unlock for your account."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Brandthread uses your photo library so you can choose photos and videos to share in posts, stories, messages, products and designs.",
          "savePhotosPermission": "Brandthread saves photos and videos to your library only when you tap Save or Download, for example when exporting a design or saving a video from Thread.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Brandthread uses your photo library so you can choose photos and videos to share in posts, stories, messages, products and designs.",
          "cameraPermission": "Brandthread uses your camera so you can take photos and record videos for posts, stories, products and designs, and so others can see you when you go live or join a video call.",
          "microphonePermission": "Brandthread uses your microphone to record sound for your videos and voice messages, and so others can hear you when you go live or join a call.",
          "colors": {
            "cropToolbarColor": "#0A0A0B",
            "cropToolbarIconColor": "#F7F7FA",
            "cropToolbarActionTextColor": "#F7F7FA",
            "cropBackButtonIconColor": "#F7F7FA",
            "cropBackgroundColor": "#0A0A0B"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#0A0A0B",
              "cropToolbarIconColor": "#F7F7FA",
              "cropToolbarActionTextColor": "#F7F7FA",
              "cropBackButtonIconColor": "#F7F7FA",
              "cropBackgroundColor": "#0A0A0B"
            }
          }
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Brandthread uses your camera so you can take photos and record videos for posts, stories, products and designs, and so others can see you when you go live or join a video call.",
          "microphonePermission": "Brandthread uses your microphone to record sound for your videos and voice messages, and so others can hear you when you go live or join a call.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C7CDD5",
          "sounds": [
            "./assets/sounds/order_received.wav"
          ],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Brandthread uses your microphone to record sound for your videos and voice messages, and so others can hear you when you go live or join a call."
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Brandthread uses Face ID to unlock the app when App Lock is turned on."
        }
      ],
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/with-sentry-upload-guard"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
