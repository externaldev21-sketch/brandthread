      }
    },
    "android": {
      "package": "com.brandthread.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "./plugins/with-verify-app-identity",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Brandthread needs access to your photos so you can post them to your story.",
          "savePhotosPermission": "Brandthread needs access to save photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Brandthread needs camera access to record videos and take photos for posts.",
          "microphonePermission": "Brandthread needs microphone access to record video with audio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C7CDD5",
          "sounds": [
            "./assets/sounds/order-received.wav"
          ],
          "iosDisplayInForeground": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
