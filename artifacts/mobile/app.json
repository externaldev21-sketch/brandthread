    "name": "Brandthread",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/monochrome.png",
    "scheme": "brandthread",
    "userInterfaceStyle": "automatic",
