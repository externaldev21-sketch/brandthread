{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Brandthread design tokens. True black, bold sans typography, and one saturated blue-violet accent.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F6F3EE" },
      "foreground": { "$value": "#11100F" },
      "border": { "$value": "#D8D1C7" },
      "card": { "$value": "#EEE9E2" },
      "cardForeground": { "$value": "#11100F" },
      "popover": { "$value": "#F6F3EE" },
      "popoverForeground": { "$value": "#11100F" },
      "primary": {
        "$value": "#5B5CFF",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#24211E" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#E4DED5" },
      "mutedForeground": { "$value": "#675F57" },
      "accent": { "$value": "#5B5CFF" },
      "accentForeground": { "$value": "#0A0908" },
      "destructive": { "$value": "#C92A2A" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#CFC6BA" },
      "ring": { "$value": "#5B5CFF" },
      "chart1": { "$value": "#5B5CFF" },
      "chart2": { "$value": "#9B5DE5" },
      "chart3": { "$value": "#0E9488" },
      "chart4": { "$value": "#E8A317" },
      "chart5": { "$value": "#B43A66" },
      "sidebar": { "$value": "#171513" },
      "sidebarForeground": { "$value": "#F6F3EE" },
      "sidebarBorder": { "$value": "#39332E" },
      "sidebarPrimary": { "$value": "#5B5CFF" },
      "sidebarPrimaryForeground": { "$value": "#0A0908" },
      "sidebarAccent": { "$value": "#2A2622" },
      "sidebarAccentForeground": { "$value": "#F6F3EE" },
      "sidebarRing": { "$value": "#5B5CFF" }
    },
    "dark": {
      "background": { "$value": "#0A0A0B" },
      "foreground": { "$value": "#F7F7FA" },
      "border": { "$value": "#2A2A2F" },
      "card": { "$value": "#18181B" },
      "cardForeground": { "$value": "#F7F7FA" },
      "popover": { "$value": "#222226" },
      "popoverForeground": { "$value": "#F7F7FA" },
      "primary": { "$value": "#5B5CFF" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#222226" },
      "secondaryForeground": { "$value": "#F7F7FA" },
      "muted": { "$value": "#18181B" },
      "mutedForeground": { "$value": "#A1A1AA" },
      "accent": { "$value": "#5B5CFF" },
      "accentForeground": { "$value": "#FFFFFF" },
      "destructive": { "$value": "#E5484D" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#2A2A2F" },
      "ring": { "$value": "#5B5CFF" },
      "chart1": { "$value": "#5B5CFF" },
      "chart2": { "$value": "#8B8CFF" },
      "chart3": { "$value": "#5B5CFF" },
      "chart4": { "$value": "#F1B943" },
      "chart5": { "$value": "#E66B9A" },
      "sidebar": { "$value": "#0A0A0B" },
      "sidebarForeground": { "$value": "#F7F7FA" },
      "sidebarBorder": { "$value": "#2A2A2F" },
      "sidebarPrimary": { "$value": "#5B5CFF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#18181B" },
      "sidebarAccentForeground": { "$value": "#F7F7FA" },
      "sidebarRing": { "$value": "#5B5CFF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Bold, confident sans-serif display and UI family."
      },
      "serif": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
