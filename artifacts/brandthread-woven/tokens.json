{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Brandthread Woven design tokens. Neutral charcoal is the base; ember is the signature fallback accent when a seller has not selected a user-scoped brand color.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F6F3EE" },
      "foreground": { "$value": "#11100F" },
      "border": { "$value": "#D8D1C7" },
      "card": { "$value": "#EEE9E2" },
      "cardForeground": { "$value": "#11100F" },
      "popover": { "$value": "#F6F3EE" },
      "popoverForeground": { "$value": "#11100F" },
      "primary": {
        "$value": "#E84624",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#24211E" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#E4DED5" },
      "mutedForeground": { "$value": "#675F57" },
      "accent": { "$value": "#FF5A36" },
      "accentForeground": { "$value": "#0A0908" },
      "destructive": { "$value": "#C92A2A" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#CFC6BA" },
      "ring": { "$value": "#E84624" },
      "chart1": { "$value": "#E84624" },
      "chart2": { "$value": "#9B5DE5" },
      "chart3": { "$value": "#0E9488" },
      "chart4": { "$value": "#E8A317" },
      "chart5": { "$value": "#B43A66" },
      "sidebar": { "$value": "#171513" },
      "sidebarForeground": { "$value": "#F6F3EE" },
      "sidebarBorder": { "$value": "#39332E" },
      "sidebarPrimary": { "$value": "#FF5A36" },
      "sidebarPrimaryForeground": { "$value": "#0A0908" },
      "sidebarAccent": { "$value": "#2A2622" },
      "sidebarAccentForeground": { "$value": "#F6F3EE" },
      "sidebarRing": { "$value": "#FF5A36" }
    },
    "dark": {
      "background": { "$value": "#080808" },
      "foreground": { "$value": "#F4F1EC" },
      "border": { "$value": "#302D2A" },
      "card": { "$value": "#121110" },
      "cardForeground": { "$value": "#F4F1EC" },
      "popover": { "$value": "#171513" },
      "popoverForeground": { "$value": "#F4F1EC" },
      "primary": { "$value": "#FF5A36" },
      "primaryForeground": { "$value": "#0A0908" },
      "secondary": { "$value": "#23201D" },
      "secondaryForeground": { "$value": "#F4F1EC" },
      "muted": { "$value": "#1B1917" },
      "mutedForeground": { "$value": "#A49D95" },
      "accent": { "$value": "#FF5A36" },
      "accentForeground": { "$value": "#0A0908" },
      "destructive": { "$value": "#E5484D" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#37322E" },
      "ring": { "$value": "#FF5A36" },
      "chart1": { "$value": "#FF5A36" },
      "chart2": { "$value": "#B27AF2" },
      "chart3": { "$value": "#24B5A9" },
      "chart4": { "$value": "#F1B943" },
      "chart5": { "$value": "#E66B9A" },
      "sidebar": { "$value": "#0D0C0B" },
      "sidebarForeground": { "$value": "#F4F1EC" },
      "sidebarBorder": { "$value": "#302D2A" },
      "sidebarPrimary": { "$value": "#FF5A36" },
      "sidebarPrimaryForeground": { "$value": "#0A0908" },
      "sidebarAccent": { "$value": "#211E1B" },
      "sidebarAccentForeground": { "$value": "#F4F1EC" },
      "sidebarRing": { "$value": "#FF5A36" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"],
        "$description": "Condensed editorial display and UI face."
      },
      "serif": { "$value": ["Cormorant Garamond", "Georgia", "serif"] },
      "mono": { "$value": ["IBM Plex Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
